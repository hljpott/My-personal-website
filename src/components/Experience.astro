---
interface Role {
	organization: string;
	role: string;
	detail: string;
	companyContext?: string;
	departments?: string[];
	observations?: string;
	reflection?: string;
}

const roles: Role[] = [
	{
		organization: "IDEXX UK",
		role: "Three-day work experience placement",
		detail: "Veterinary diagnostics and animal health",
		companyContext:
			"IDEXX provides diagnostic testing and services that support animal health. During my three-day placement, I toured specialist laboratory departments and gained an insight into how a professional diagnostic laboratory works.",
		departments: [
			"Anatomic Pathology & Histopathology",
			"Clinical Pathology",
			"Microbiology & Culture",
			"Immunology",
			"Hematology",
		],
		observations:
			"I observed the microbiology team testing swabs on slides, scientists examining samples under microscopes for signs of cancer, and staff analysing blood samples.",
		reflection:
			"It was a rewarding introduction to a real laboratory and to the highly trained people working across it. The experience deepened my understanding of laboratory science and showed me how careful analysis, specialist knowledge, and collaboration contribute to a science-led business. It strengthened my enthusiasm for a future career in the pharmaceutical or wider science sector.",
	},
	{
		organization: "Red Lion Inn",
		role: "Hospitality",
		detail: "An inn that hosts weddings",
	},
	{
		organization: "Dairy farm",
		role: "Calf rearer",
		detail: "Practical experience in dairy farming",
	},
	{
		organization: "Acroyds",
		role: "Bar work",
		detail: "A busy bar environment",
	},
];
---

<section class="experience-section" id="experience" aria-labelledby="experience-title">
	<div class="section-inner">
		<div class="section-heading">
			<p class="eyebrow"><span class="eyebrow-rule"></span>Professional experience</p>
			<h2 id="experience-title">A broad base of experience</h2>
			<p>Work experience at IDEXX UK, alongside hands-on roles in agriculture and hospitality.</p>
		</div>
		<ol class="experience-list">
			{roles.map((item, index) => (
				<li>
					<span class="experience-number" aria-hidden="true">0{index + 1}</span>
					<div class="experience-identity">
						<h3>{item.organization}</h3>
						<p>{item.role}</p>
					</div>
					<p class="experience-detail">{item.detail}</p>
					{item.companyContext && (
						<div class="experience-expanded">
							<p>{item.companyContext}</p>
							<h4>Departments visited</h4>
							<ul class="department-list">
								{item.departments?.map((department) => <li>{department}</li>)}
							</ul>
							<p>{item.observations}</p>
							<p class="experience-reflection">{item.reflection}</p>
						</div>
					)}
				</li>
			))}
		</ol>
	</div>
</section>